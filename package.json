{
  "name": "mindtrack",
  "version": "1.0.0",
  "description": "Русскоязычный статический справочник по самонаблюдению и скрининговым шкалам.",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Simifar/mindtrack.git"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && bun scripts/copy-standalone.ts",
    "start": "cross-env NODE_ENV=production bun .next/standalone/server.js",
    "build:pages": "bun scripts/build-pages.ts",
    "check:pages": "bun scripts/check-pages.ts",
    "preview:pages": "bun scripts/preview-pages.ts",
    "validate-content": "bun scripts/validate-content.ts",
    "check-bundle": "bun scripts/check-bundle.ts",
    "lint": "eslint .",
    "test": "bun test"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
